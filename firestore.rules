rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Replace with your Firebase Authentication UID before publishing.
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_FIREBASE_AUTH_UID';
    }
    function hasConsent() {
      return request.resource.data.privacyConsent.accepted == true
        && request.resource.data.privacyConsent.acceptedAt is string
        && request.resource.data.privacyConsent.noticeVersion == '2026-11-27-v1';
    }
    match /users/{userId} {
      // A user reads their own backup; allowlisted admin can read all user records.
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Each user can write only their own record, and writes must include consent metadata.
      allow create, update: if request.auth != null && request.auth.uid == userId && hasConsent();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}